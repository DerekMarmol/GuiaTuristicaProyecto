{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/backend/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "postinstall": "prisma skills sync || exit 0",
    "ai:test": "tsx src/ai/validator.test.ts && tsx --test src/ai/validacionEstancia.test.ts src/ai/validacionApertura.test.ts",
    "ai:probar": "tsx src/ai/scripts/probar.ts",
    "ai:tipos": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck src/ai/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.7",
    "opening_hours": "^3.15.0",
    "zod": "^3.25.76"
  }
}
